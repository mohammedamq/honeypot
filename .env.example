# Multi-Protocol Honeypot Environment Configuration
# Copy this file to .env and customize for your deployment

# OpenSearch Configuration
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# Network Configuration
HONEYPOT_NETWORK_SUBNET=172.25.0.0/24

# Cowrie Configuration
COWRIE_HOSTNAME=srv-prod-01
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2323

# OpenCanary Configuration
OPENCANARY_HTTP_PORT=8080
OPENCANARY_NODE_ID=opencanary-honeypot-01

# Logging Configuration
LOG_LEVEL=info

# Timezone
TZ=UTC

# Optional: SIEM Integration
# SYSLOG_HOST=
# SYSLOG_PORT=514
